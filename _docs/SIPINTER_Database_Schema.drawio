        <!-- ================= reference blocks ================= -->
        <mxCell id="fkref" value="Ringkasan Foreign Key: users.role_id→roles · user_tim.user_id→users · iku_penugasan.{iku_id→master_iku, user_id→users} · kegiatan.{iku_id→master_iku, periode_id→periode, rtl_evaluasi_id→rtl_evaluasi} · capaian.{iku_id→master_iku, periode_id→periode} · kendala_solusi.{iku_id→master_iku, periode_id→periode} · rtl_evaluasi.{iku_id→master_iku, periode_id→periode} · berkas.storage_account_id→storage_account · notula.{periode_id→periode, disetujui_oleh_user_id→users} · iku_folder_config.iku_id→master_iku · bagian_kustom_poin.{bagian_kustom_id→bagian_kustom, iku_id→master_iku, periode_id→periode} · lakin_baris.{lakin_id→lakin, iku_id→master_iku (nullable)}. Semua FK ON UPDATE CASCADE; ON DELETE bervariasi per tabel (restrict/cascade/null) — lihat migrasi untuk detail per kolom." style="text;html=1;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="700" y="950" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="polyref" value="Relasi polimorfik (bukan FK constraint sungguhan): berkas.ref_id + berkas.ref_type menunjuk ke salah satu dari capaian / kendala_solusi / rtl_evaluasi / notula / bagian_kustom_poin, tergantung nilai berkas.kategori (kolom ini adalah CHECK constraint dengan 6 nilai: capaian, solusi, evaluasi_rtl, bukti_dukung_sakip, notula, bagian_kustom — nilai terakhir ditambahkan lewat migrasi terpisah setelah tabel berkas dibuat). Tabel infrastruktur Laravel (sessions, cache, jobs, password_reset_tokens) sengaja tidak dicantumkan karena bukan entitas domain aplikasi." style="text;html=1;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="700" y="1140" width="610" height="110" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legenda warna: Biru = pengguna/periode/notula · Teal = IKU/kegiatan/capaian · Amber = kendala-solusi &amp; RTL (kolom bergaris kuning tua = UNIQUE/INDEX) · Hijau = penyimpanan Drive/berkas · Ungu = keanggotaan tim &amp; konfigurasi (termasuk iku_folder_config, override pola folder per-IKU) · Indigo = Bagian Kustom · Pink = LAKIN. Teks miring = Foreign Key." style="text;html=1;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1860" width="1370" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
