        <mxCell id="roles" value="&lt;b&gt;roles&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;nama" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
