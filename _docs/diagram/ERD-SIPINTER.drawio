  <diagram id="erd-sipinter" name="ERD SIPINTER - Modul Capaian, Verifikasi, Notula">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
